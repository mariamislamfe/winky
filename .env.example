# Copy to .env.local (on your computer) or set these in your host's environment.

# Dashboard password for /admin. Use a long, unique password.
ADMIN_PASSWORD=

# Optional: extra secret mixed into dashboard sessions.
ADMIN_SESSION_SECRET=

# Your live domain, e.g. https://winky.store (used for the sitemap and share images).
SITE_URL=

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: server only. Never commit it or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=
